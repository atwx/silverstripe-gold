#!/usr/bin/env php
<?php

declare(strict_types=1);

namespace DriftChecker;

/**
 * drift-checker — On-PATH-Entry des Plugins (Konzept §6/§10).
 *
 * Wird vom Claude-Code-Plugin als Bare-Command in den PATH gelegt. Liest
 * .gold-profile.yml aus dem Projekt-Root, merged base + <profile> + features
 * und vergleicht den Ist-Zustand gegen den Idealstand → JSON-Report (§6).
 *
 * Engine-Quellcode liegt in ../tool/src, Profile in ../profiles. Da die Engine
 * dependency-frei ist, braucht das Plugin kein `composer install` und kein PHAR.
 *
 * Usage:
 *   drift-checker [--project=DIR] [--profiles=DIR] [--composer=BIN] [--compact]
 */

$root = dirname(__DIR__);

// Bevorzugt einen generierten Autoloader (falls jemand im tool/ install macht),
// sonst manuelles, install-freies Laden.
$autoload = $root . '/tool/vendor/autoload.php';
if (is_file($autoload)) {
    require $autoload;
} else {
    foreach (
        ['Yaml', 'ProfileResolver', 'ComposerInspector', 'ForkChecker',
            'ModuleChecker', 'FrontendChecker', 'ReportBuilder'] as $class
    ) {
        require $root . '/tool/src/' . $class . '.php';
    }
}

/** @return array<string,string> */
function parseArgs(array $argv): array
{
    $opts = [];
    foreach (array_slice($argv, 1) as $arg) {
        if (preg_match('/^--([a-z-]+)(?:=(.*))?$/', $arg, $m)) {
            $opts[$m[1]] = $m[2] ?? '1';
        }
    }

    return $opts;
}

function fail(string $message): never
{
    fwrite(STDERR, "drift-checker: {$message}\n");
    exit(1);
}

$opts = parseArgs($argv);

$projectDir = isset($opts['project'])
    ? rtrim($opts['project'], '/')
    : getcwd();
$profilesDir = isset($opts['profiles'])
    ? rtrim($opts['profiles'], '/')
    : realpath($root . '/profiles');
// DDEV zuerst erkennen; explizites --composer übersteuert.
$composerBin = $opts['composer'] ?? ComposerInspector::detectComposerBinary($projectDir);
$pretty = !isset($opts['compact']);

if (!is_dir($projectDir)) {
    fail("Projektverzeichnis existiert nicht: {$projectDir}");
}
if ($profilesDir === false || !is_dir($profilesDir)) {
    fail('Profil-Ordner nicht gefunden (--profiles=...).');
}

try {
    $resolver = new ProfileResolver($profilesDir);
    $pointer = $resolver->readPointer($projectDir);
    $effectiveProfile = $resolver->resolve($pointer);

    $inspector = new ComposerInspector($projectDir, $composerBin);
    $outdated = $inspector->outdatedDirect();
    $directDeps = $inspector->directDependencyNames();
    $installed = $inspector->installedPackages();
    $repo = $inspector->projectName();

    $extraItems = array_merge(
        (new ForkChecker())->check($effectiveProfile, $installed),
        (new ModuleChecker())->check($effectiveProfile, $installed),
        (new FrontendChecker())->check($effectiveProfile, $projectDir),
    );

    $report = (new ReportBuilder())->build(
        repo: $repo,
        pointer: $pointer,
        effectiveProfile: $effectiveProfile,
        outdated: $outdated,
        directDeps: $directDeps,
        extraItems: $extraItems,
        composerCmd: $composerBin,
        checkedAt: gmdate('Y-m-d\TH:i:s\Z'),
    );
} catch (\Throwable $e) {
    fail($e->getMessage());
}

$flags = JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE;
if ($pretty) {
    $flags |= JSON_PRETTY_PRINT;
}

echo json_encode($report, $flags), "\n";
